{
  "expo": {
    "name": "FlightWatcher",
    "slug": "flightwatcher",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flightwatcher",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flightwatcher.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33"
      },
      "package": "com.flightwatcher.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "flightwatcher",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "flightwatcher",
              "host": "planner",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
