# Leave empty to auto-detect LAN IP from Expo Metro host.
# Or set explicitly, e.g. http://192.168.1.161:8000
EXPO_PUBLIC_API_URL=http://192.168.1.161:8000

# Public HTTPS origin for OAuth callback (Cloudflare quick tunnel on :8000).
# Required on Expo Go: Supabase rejects exp://192.168… (LAN IP).
# Example: cloudflared tunnel --url http://127.0.0.1:8000
# EXPO_PUBLIC_AUTH_CALLBACK_ORIGIN=https://xxxx.trycloudflare.com
