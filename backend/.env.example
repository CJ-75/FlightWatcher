SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated CORS origins (web Vite, Expo web, production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173

# Deals tab provider: mock | liteapi | expedia | lastminute
# liteapi = GET /api/deals jointure caches uniquement (0 appel LiteAPI)
DEALS_PROVIDER=liteapi

# LiteAPI (required for bootstrap pools + when DEALS_PROVIDER=liteapi)
# Hotels are city-axis (served_cities): arrival IATA → city → deal_destinations pool.
# After apply_deal_destinations_served_city.sql, refresh in order:
#   POST /api/deals/jobs/bootstrap-hotel-pools   (links served_city_id + rebuilds pools)
#   POST /api/deals/jobs/refresh-hotel-rates     (top_n=12 / city)
#   POST /api/deals/jobs/materialize-wall        (hotel shortlist on deals_active)
# Other jobs (Bearer CRON_SECRET):
#   POST /api/deals/jobs/refresh-deal-flights
#   POST /api/deals/jobs/refresh-deal-calendar
#   POST /api/deals/jobs/check-price-alerts
# Hotel upsell Search/Planner: POST /api/deals/hotel-upsell/lookup|fetch
#   (iata = arrival airport; resolved to served city — origin ignored)
# CLI: python -m deals.bootstrap_pools | refresh_flights | refresh_rates | refresh_calendar | check_price_alerts
# Liked-deal price alert threshold (% drop). Cooldown 24h per deal.
DEALS_PRICE_ALERT_THRESHOLD_PCT=8
LITEAPI_ENV=sandbox
LITEAPI_API_KEY_SANDBOX=sand_3fe7e8dd-d83c-4799-b114-3af2101bdef9
LITEAPI_API_KEY_PROD=
LITEAPI_PAYMENT_PUBLIC_KEY_SANDBOX=
LITEAPI_PAYMENT_PUBLIC_KEY_PROD=
# Optional overrides (defaults are LiteAPI v3.0)
# LITEAPI_SEARCH_BASE=https://api.liteapi.travel/v3.0
# LITEAPI_BOOK_BASE=https://book.liteapi.travel/v3.0
LITEAPI_TIMEOUT_S=8
LITEAPI_MAX_CONCURRENCY=4
LITEAPI_MARGIN_MAX_PCT=25

DEALS_CURRENCY=EUR
DEALS_GUEST_NATIONALITY=FR
DEALS_WEEKENDS_AHEAD=3
# L8 flags (off by default): add SAT_MON and/or solo adults=1
DEALS_WINDOW_KINDS=FRI_SUN
# DEALS_WINDOW_KINDS=FRI_SUN,SAT_MON
DEALS_OCCUPANCIES=2
# DEALS_OCCUPANCIES=2,1
DEALS_CALENDAR_WEEKENDS_AHEAD=8
DEALS_BUDGET_FLIGHT_PP=150
DEALS_BUDGET_PACK_PP=350
DEALS_BUDGET_PACK_PP_LONGHAUL=1200
DEALS_MAX_FLIGHT_PP_LONGHAUL=650
DEALS_SOFT_MAX_FLIGHT_PP_LONGHAUL=750
DEALS_ORGANIC_BEAT_EUR=8
DEALS_ORGANIC_BEAT_PCT=0.05
DEALS_ORGANIC_TTL_H=12
DEALS_ONDEMAND_ENABLED=true
# Origins scanned into deal_flight_cache (comma-separated IATA)
DEALS_ORIGINS=BVA,ORY,CDG,MRS,NCE,LYS,TLS,BRU,AMS,BCN,FCO,MAD,LGW,DUS
# DEALS_SCORE_WEIGHTS={"prix":1.0,"note":0.35,"dist":0.25,"breakfast":0.15,"refundable":0.05,"late":0.3}
# Product conventions
DEALS_EXCLUDED_FEES_DISPLAY=separate
DEALS_FLIGHT_CTA_TIMING=after_hotel
# L11 — prod lecture seule : UI on, booking off (batch/cache actifs)
DEALS_UI_ENABLED=true
DEALS_BOOKING_ENABLED=true
# Alertes (onglet /alertes) — off = masqué + routes redirigées
ALERTS_UI_ENABLED=false

# ——— Flights / Travelpayouts ———
TRAVELPAYOUTS_ENABLED=false
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
# Generate a long random value and include it as ?secret=... in the postback URL.
TRAVELPAYOUTS_POSTBACK_SECRET=
# Dashboard postback:
# https://api.example.com/api/webhooks/travelpayouts/flight-booking
#   ?secret=YOUR_SECRET
#   &sub_id=%{additional_marker}
#   &status=%{status}
#   &booking_id=%{bookingId}

# ——— Activities / Viator (parcours ③) ———
# Required when ACTIVITIES_ENABLED=true (sandbox key from Viator partner portal)
VIATOR_API_KEY=
VIATOR_ENV=sandbox
VIATOR_CACHE_TTL_H=24
VIATOR_MAX_RETRIES=4
ACTIVITIES_ENABLED=false
ACTIVITIES_SNAPSHOT_REFRESH=weekly
ACTIVITIES_MIN_RESULTS=21
ACTIVITIES_MAX_RESULTS=30
ACTIVITIES_RADIUS_STEPS_KM=10,25,50,100,150
ACTIVITIES_MAX_QUERIES_PER_GEO=6
ACTIVITIES_GEO_CACHE_CELL_KM=5
ACTIVITIES_QUALITY_STEPS=4.5:50,4.3:20,4.0:10
# Planner steps ③ / ④ — set true once SQL migrations applied
PLANNER_ACTIVITIES_ENABLED=false
PLANNER_RESTAURANTS_ENABLED=false
ITINERARIES_ENABLED=false

# ——— Restaurants / Tes adresses (parcours ④) ———
LINK_IMPORT_ENABLED=false
LINK_IMPORT_MAX_LINKS=20
LINK_RESOLVE_ALLOWED_HOSTS=maps.app.goo.gl,goo.gl,www.google.com,www.google.fr,maps.google.com
LINK_RESOLVE_MAX_REDIRECTS=3
PLACE_MATCH_RADIUS_M=150
PLACE_MATCH_MIN_SIMILARITY=0.45
PLACE_PUBLIC_MIN_DISTINCT_USERS=3
# Geocoding / place match (Geoapify) — required for link import in prod
GEOAPIFY_API_KEY=
# Optional Google Places enrichment
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_LOOKUP_ENABLED=false
GOOGLE_PHOTOS_ENABLED=false
LLM_ENRICH_ENABLED=false
LLM_MODEL=claude-haiku-5-5
LLM_WEB_SEARCH_ENABLED=false
LLM_DAILY_CALL_CAP=500
RESTAURANTS_LOCAL_DISHES_ENABLED=true
# Sandbox network tests: LITEAPI_INTEGRATION=1 python -m unittest deals.test_integration_sandbox

# ——— Deals v3 community ———
# community = deals_active from observations+seed ; legacy_catalog = weekend caches L1–L11
DEALS_SOURCE=community
DEALS_OBSERVATIONS_ENABLED=true
DEALS_MAX_FLIGHT_PP=140
DEALS_MIN_PER_ORIGIN=12
DEALS_NEARBY_ORIGINS_KM=100
DEALS_FRESH_TAU_H=12
DEALS_FRESH_TAU_SHORT_H=6
DEALS_REVALIDATE_BUDGET_PER_HOUR=10
# DEALS_COMMUNITY_SCORE_WEIGHTS={"disc":1.0,"fresh":0.4,"pop":0.2,"qual":0.2,"hotel":0.15}
# Trend catalog P0–P2 (classics + VP destinations)
SEED_CATALOG_SIZE=80
# Seed budget: Travelpayouts bulk + sparse Ryanair overlay (see SEED_RYANAIR_*)
SEED_SCAN_BUDGET_PER_DAY=250
# Max €/pp accepted while seeding (baselines need headroom; promote still uses DEALS_MAX_FLIGHT_PP)
SEED_SCAN_MAX_PP=450
SEED_PRIORITY_ORIGINS=BVA,MRS,NTE,BOD,TLS,LYS,BRU,AMS
SEED_DATE_SETS=WEEKEND3,SHORT1,WEEK1
SEED_DATE_SETS_LONGHAUL=LONGHAUL3
SEED_MIN_BUDGET_SHARE=0.2
# Ryanair in seed — sparse & slow (avoid 403); TP remains the bulk fill
SEED_RYANAIR_ENABLED=true
SEED_RYANAIR_ORIGINS=BVA,MRS,NTE,TLS,NCE,LIL,BIQ,BZR,XCR,GNB
SEED_RYANAIR_MAX_CELLS_PER_RUN=18
SEED_RYANAIR_PAUSE_S=4.0
SEED_RYANAIR_DEST_ALLOWLIST=AMS,ATH,BER,IBZ,VCE,GLA,HER,AGA,BCN,MAD,FCO,STN,EDI,LIS,OPO,BUD,PRG,KRK,CIA,BGY,NAP,PMI,AGP,VLC,SVQ,MLA,NYO,TIA,OTP,SOF,BEG,SPU,DBV,ZAG,FLR,BLQ,TRN,CPH,KEF,FAO,CTA,PMO,BRI,JTR,TFS,LPA,PDL,RAK,TUN,DJE
# Provider throttle / circuit (seed+revalidate keep slow gap)
PROVIDER_MIN_INTERVAL_S=1.0
PROVIDER_RYANAIR_MIN_INTERVAL_S=2.5
# Organic Search/inspire: per-provider fast gap (Ryanair ≠ Travelpayouts slots)
SEARCH_PROVIDER_MIN_INTERVAL_S=0.15
# Soft merge: always both providers; don't wait forever on the slowest
SEARCH_MERGE_DEADLINE_S=8
SEARCH_MERGE_GRACE_S=2.5
# Progressive inspire stream (first provider ready wins, others append) — seconds
SEARCH_STREAM_DEADLINE_S=28
PROVIDER_CIRCUIT_FAILS=3
PROVIDER_CIRCUIT_COOLDOWN_S=900
SEED_SCAN_PAUSE_S=1.2
# v3.2 Ryanair shared budget (click > revalidate > organic > promote)
RYANAIR_BUDGET_PER_HOUR=40
RYANAIR_CACHE_TTL_S=7200
DEALS_JOB_LOCK_TTL_MIN=45
# My-trip Resend rate limits
MY_TRIP_EMAIL_PER_EMAIL_PER_HOUR=3
MY_TRIP_EMAIL_PER_DRAFT_PER_HOUR=5
MY_TRIP_EMAIL_GLOBAL_PER_HOUR=60
OBS_RETENTION_DAYS=90
# Optional salt for anonymous search fingerprints (defaults to CRON_SECRET)
# OBS_FINGERPRINT_SECRET=

# ——— Deals v3.1 Lot A ———
# One-shot: cd backend && python -m deals.bootstrap_community
# SQL first (manual): apply_deals_community_migration.sql + apply_deals_job_runs_migration.sql
DEALS_SCHEDULER_ENABLED=true
DEALS_BASELINE_MAX_AGE_H=36
DEALS_LEGACY_FALLBACK_ENABLED=false
DEALS_CALENDAR_ENABLED=false
DEALS_MIN_DISCOUNT=0.10
# ——— Deals v3.1 Lot C (live / cached) ———
DEALS_CACHED_ENABLED=true
DEALS_CACHED_MAX_SHARE=0.50
# Wall / promote diversity — 0 = off (BVA-heavy: don't starve main origin)
DEALS_WALL_MAX_DEALS=160
DEALS_WALL_MAX_PER_CITY=0
DEALS_WALL_MAX_PER_COUNTRY=0
DEALS_PROMOTE_MAX_PER_CITY=0
DEALS_PROMOTE_MAX_PER_COUNTRY=0
DEALS_PROMOTE_PER_ORIGIN=120
DEALS_SOFT_MAX_FLIGHT_PP=210
DEALS_SOFT_LOOKBACK_H=72
# Shared L2 wall cache across workers (Phase 3)
DEALS_WALL_SHARED_CACHE=true
DEALS_WALL_CACHE_TTL_S=480
# Age filter unused until Travelpayouts exposes found_at (not in current mapping)
DEALS_CACHED_MAX_AGE_H=48
DEALS_KILL_MIN_CLICKS=30
DEALS_KILL_THRESHOLD=0.25
# SQL: apply_deals_v31_lot_c_migration.sql
# Community jobs (Bearer CRON_SECRET) still available; scheduler covers them when enabled.
# Mon voyage: POST /api/deals/my-trip  GET /api/deals/my-trip/{token}

# ——— Deals v3.3 — un mur qui ne meurt pas ———
