{
  "expo": {
    "name": "WayPop",
    "slug": "waypop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": ["waypop", "flightwatcher"],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.waypop.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "WayPop utilise tes photos pour illustrer les étapes de parcours."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F33"
      },
      "package": "com.waypop.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "flightwatcher",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "waypop",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "flightwatcher",
              "host": "planner",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "waypop",
              "host": "planner",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
