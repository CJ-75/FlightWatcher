# Leave empty to auto-detect LAN IP from Expo Metro host.
# Or set explicitly, e.g. http://192.168.1.161:8000
EXPO_PUBLIC_API_URL=

# Web origin — must be the same app whose /auth/callback already works with
# Google → https://<project>.supabase.co/auth/v1/callback → this origin.
# EXPO_PUBLIC_WEB_URL=http://192.168.1.161:5173
