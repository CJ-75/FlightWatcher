SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated CORS origins (web Vite, Expo web, production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173

# Deals tab provider: mock | liteapi | expedia | lastminute
# liteapi = GET /api/deals jointure caches uniquement (0 appel LiteAPI)
DEALS_PROVIDER=liteapi

# LiteAPI (required for bootstrap pools + when DEALS_PROVIDER=liteapi)
# Jobs (Bearer CRON_SECRET):
#   POST /api/deals/jobs/bootstrap-hotel-pools
#   POST /api/deals/jobs/refresh-deal-flights
#   POST /api/deals/jobs/refresh-hotel-rates
#   POST /api/deals/jobs/refresh-deal-calendar
#   POST /api/deals/jobs/check-price-alerts
# Hotel upsell Search/Planner: POST /api/deals/hotel-upsell/lookup|fetch
# CLI: python -m deals.bootstrap_pools | refresh_flights | refresh_rates | refresh_calendar | check_price_alerts
# Liked-deal price alert threshold (% drop). Cooldown 24h per deal.
DEALS_PRICE_ALERT_THRESHOLD_PCT=8
LITEAPI_ENV=sandbox
LITEAPI_API_KEY_SANDBOX=sand_3fe7e8dd-d83c-4799-b114-3af2101bdef9
LITEAPI_API_KEY_PROD=
LITEAPI_PAYMENT_PUBLIC_KEY_SANDBOX=
LITEAPI_PAYMENT_PUBLIC_KEY_PROD=
# Optional overrides (defaults are LiteAPI v3.0)
# LITEAPI_SEARCH_BASE=https://api.liteapi.travel/v3.0
# LITEAPI_BOOK_BASE=https://book.liteapi.travel/v3.0
LITEAPI_TIMEOUT_S=8
LITEAPI_MAX_CONCURRENCY=4
LITEAPI_MARGIN_MAX_PCT=25

DEALS_CURRENCY=EUR
DEALS_GUEST_NATIONALITY=FR
DEALS_WEEKENDS_AHEAD=3
# L8 flags (off by default): add SAT_MON and/or solo adults=1
DEALS_WINDOW_KINDS=FRI_SUN
# DEALS_WINDOW_KINDS=FRI_SUN,SAT_MON
DEALS_OCCUPANCIES=2
# DEALS_OCCUPANCIES=2,1
DEALS_CALENDAR_WEEKENDS_AHEAD=8
DEALS_BUDGET_FLIGHT_PP=150
DEALS_BUDGET_PACK_PP=350
# Origins scanned into deal_flight_cache (comma-separated IATA)
DEALS_ORIGINS=BVA,ORY,CDG,MRS,NCE,LYS,TLS
# DEALS_SCORE_WEIGHTS={"prix":1.0,"note":0.35,"dist":0.25,"breakfast":0.15,"refundable":0.05,"late":0.3}
# Product conventions
DEALS_EXCLUDED_FEES_DISPLAY=separate
DEALS_FLIGHT_CTA_TIMING=after_hotel
# L11 — prod lecture seule : UI on, booking off (batch/cache actifs)
DEALS_UI_ENABLED=true
DEALS_BOOKING_ENABLED=true
# Sandbox network tests: LITEAPI_INTEGRATION=1 python -m unittest deals.test_integration_sandbox

# ——— Deals v3 community ———
# community = deals_active from observations+seed ; legacy_catalog = weekend caches L1–L11
DEALS_SOURCE=community
DEALS_OBSERVATIONS_ENABLED=true
DEALS_MAX_FLIGHT_PP=120
DEALS_MIN_PER_ORIGIN=12
DEALS_NEARBY_ORIGINS_KM=100
DEALS_FRESH_TAU_H=6
DEALS_FRESH_TAU_SHORT_H=3
DEALS_REVALIDATE_BUDGET_PER_HOUR=10
# DEALS_COMMUNITY_SCORE_WEIGHTS={"disc":1.0,"fresh":0.4,"pop":0.2,"qual":0.2,"hotel":0.15}
SEED_CATALOG_SIZE=25
# v3.2: seed is Travelpayouts-only — raise freely vs Ryanair era
SEED_SCAN_BUDGET_PER_DAY=80
SEED_PRIORITY_ORIGINS=BVA,MRS,NTE,BOD,TLS,LYS
SEED_DATE_SETS=WEEKEND3,SHORT1
SEED_MIN_BUDGET_SHARE=0.2
# Provider throttle / circuit (seed+revalidate)
PROVIDER_MIN_INTERVAL_S=1.0
PROVIDER_CIRCUIT_FAILS=3
PROVIDER_CIRCUIT_COOLDOWN_S=900
SEED_SCAN_PAUSE_S=1.2
# v3.2 Ryanair shared budget (click > revalidate > organic > promote)
RYANAIR_BUDGET_PER_HOUR=40
RYANAIR_CACHE_TTL_S=7200
DEALS_JOB_LOCK_TTL_MIN=45
# My-trip Resend rate limits
MY_TRIP_EMAIL_PER_EMAIL_PER_HOUR=3
MY_TRIP_EMAIL_PER_DRAFT_PER_HOUR=5
MY_TRIP_EMAIL_GLOBAL_PER_HOUR=60
OBS_RETENTION_DAYS=90
# Optional salt for anonymous search fingerprints (defaults to CRON_SECRET)
# OBS_FINGERPRINT_SECRET=

# ——— Deals v3.1 Lot A ———
# One-shot: cd backend && python -m deals.bootstrap_community
# SQL first (manual): apply_deals_community_migration.sql + apply_deals_job_runs_migration.sql
DEALS_SCHEDULER_ENABLED=true
DEALS_BASELINE_MAX_AGE_H=36
DEALS_LEGACY_FALLBACK_ENABLED=false
DEALS_CALENDAR_ENABLED=false
DEALS_MIN_DISCOUNT=0.15
# ——— Deals v3.1 Lot C (live / cached) ———
DEALS_CACHED_ENABLED=true
DEALS_CACHED_MAX_SHARE=0.30
# Age filter unused until Travelpayouts exposes found_at (not in current mapping)
DEALS_CACHED_MAX_AGE_H=48
DEALS_KILL_MIN_CLICKS=30
DEALS_KILL_THRESHOLD=0.25
# SQL: apply_deals_v31_lot_c_migration.sql
# Community jobs (Bearer CRON_SECRET) still available; scheduler covers them when enabled.
# Mon voyage: POST /api/deals/my-trip  GET /api/deals/my-trip/{token}

# Admin
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD_HASH=

# Planner auto-scan cron (Bearer token for POST /api/planner/auto-scan)
CRON_SECRET=change-me-long-random

# Public web app URL (email deep links)
WEB_APP_URL=http://localhost:5173

# Resend (optional — emails skipped if unset)
RESEND_API_KEY=
RESEND_FROM=FlightWatcher <onboarding@resend.dev>
