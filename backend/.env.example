DEALS_HEALTH_MIN_DEALS_WITH_PHOTO=8
DEALS_HEALTH_MIN_FRESH_HOTEL_RATE_SHARE=0.70
DEALS_HEALTH_BASELINE_MAX_AGE_H=36
DEALS_HEALTH_RYANAIR_403_MAX_SHARE=0.05
