{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm exec -w waypop-frontend -- vite build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.waypop.co/api/:path*"
    },
    {
      "source": "/auth/mobile-callback",
      "destination": "https://api.waypop.co/auth/mobile-callback"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
