# Optional absolute API URL.
# Dev (Vite alone): leave empty → proxy /api → localhost:8000
# Prod Vercel Services: leave empty → same-origin /api rewrite
# Prod split (Render API): set absolute URL, e.g. https://xxx.onrender.com
# VITE_API_URL=http://localhost:8000

# Media: api (default → Supabase Storage via backend) | supabase | none
# VITE_MEDIA_PROVIDER=api
# Image Transforms (resize CDN) — often needs Supabase Pro
# VITE_MEDIA_TRANSFORMS=1
