# ─── Local / Expo Go (LAN) ───────────────────────────────────────────
# Physical device: PC LAN IP (same Wi‑Fi as the phone).
# Leave empty to auto-detect from Metro hostUri.
EXPO_PUBLIC_API_URL=http://192.168.1.161:8000

# Public web app origin for Planner invites + « Ajouter un hôtel » (MyTrip compose).
# Required on a physical device if the API is local (phone cannot open localhost:5173).
# EXPO_PUBLIC_WEB_ORIGIN=http://192.168.1.161:5173

# Expo Go OAuth bridge only (unsupported for store). Supabase rejects exp://192.168…
# cloudflared tunnel --url http://127.0.0.1:8000 → add URL in Supabase Redirect URLs.
# EXPO_PUBLIC_AUTH_CALLBACK_ORIGIN=https://xxxx.trycloudflare.com

# ─── EAS preview / production (stores) ───────────────────────────────
# Set in eas.json env (already) or EAS Secrets — never ship LAN / Cloudflare:
#   EXPO_PUBLIC_API_URL=https://waypop.co
#   EXPO_PUBLIC_WEB_ORIGIN=https://waypop.co
# Do NOT set EXPO_PUBLIC_AUTH_CALLBACK_ORIGIN on store builds (use waypop://).

# Public anon credentials (same as backend SUPABASE_*). Fallback when /api/config fails.
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ…

# Media: api (default, POST /api/media/upload → Supabase) | supabase (direct client) | none
# EXPO_PUBLIC_MEDIA_PROVIDER=api
# EXPO_PUBLIC_MEDIA_TRANSFORMS=1
