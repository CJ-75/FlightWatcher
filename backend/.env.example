DEALS_RATES_STALE_GRACE_H=24
DEALS_RATES_REFRESH_MAX_CALLS=180
HOTEL_POOL_BOOTSTRAP_PAUSE_S=3
DEALS_SOFT_FILL_MODE=flight_only
