{
  "name": "flightwatcher-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node ./scripts/check-node.js && expo start",
    "start:tunnel": "node ./scripts/check-node.js && expo start --tunnel",
    "android": "node ./scripts/check-node.js && expo start --android",
    "ios": "node ./scripts/check-node.js && expo start --ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "@flightwatcher/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.90.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-auth-session": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "is-arrayish": "^0.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
